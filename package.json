{
  "name": "secondnature",
  "version": "0.2.0",
  "description": "Teach your coding agents something once and it becomes second nature: lessons from your past Claude Code, Codex and Cursor sessions, told to agents when they matter.",
  "license": "MIT",
  "author": "Rohit Parthasarathy",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "coding-agent",
    "ai-agent",
    "memory",
    "lessons",
    "hooks"
  ],
  "homepage": "https://github.com/Rohitp/secondnature#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rohitp/secondnature.git"
  },
  "bugs": {
    "url": "https://github.com/Rohitp/secondnature/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "secondnature": "dist/cli.js",
    "muninn": "dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "mods/muninn-panel/.claude-plugin",
    "mods/muninn-panel/.mcp.json",
    "mods/muninn-panel/hooks",
    "mods/muninn-panel/types",
    "mods/muninn-panel/README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@libsql/client": "^0.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "protobufjs"
    ]
  }
}
